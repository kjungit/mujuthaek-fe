# 백엔드 api 주소 (mujuthaek-be services/api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# 웹 푸시 VAPID 공개 키 (pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 목업 대신 실제 API를 부를 때 false (기본은 목업)
NEXT_PUBLIC_USE_MOCKS=true
# Google Analytics 4 측정 ID (G-…). 비우면 GA를 쓰지 않아요. 운영·개발 속성 ID를 따로 넣어요
NEXT_PUBLIC_GA_ID=
# 1이면 GA 이벤트가 DebugView에만 보여요(개발 확인용)
NEXT_PUBLIC_GA_DEBUG=
