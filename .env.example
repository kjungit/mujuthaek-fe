# 백엔드 api 주소 (mujuthaek-be services/api)
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
# 웹 푸시 VAPID 공개 키 (pnpm dlx web-push generate-vapid-keys)
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
# 목업 대신 실제 API를 부를 때 false (기본은 목업)
NEXT_PUBLIC_USE_MOCKS=true
# Google Analytics 4 측정 ID (G-…). 비우면 GA를 쓰지 않아요. 운영·개발 속성 ID를 따로 넣어요
NEXT_PUBLIC_GA_ID=
# 1이면 GA 이벤트가 DebugView에만 보여요(개발 확인용)
NEXT_PUBLIC_GA_DEBUG=

# 화면 요청 기록(서버 전용, 브라우저로 안 나감): 화면만 긁는 봇을 관리자 「트래픽」에서 보려고 api로 넘겨요. 비우면 안 넘겨요
# TRAFFIC_INGEST_URL=http://localhost:8080
# TRAFFIC_INGEST_TOKEN=api의 TRAFFIC_INGEST_TOKEN과 같은 값
